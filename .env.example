# supacharge-web — environment variables this shell reads.
#
# Copy to .env.local for local development. Never commit real values: secrets
# live in the private RokctAI/occultation workspace and are set in the Vercel
# project's Environment Variables, not in this file.

# ---------------------------------------------------------------------------
# Public origin of this deployment.
# ---------------------------------------------------------------------------
# Read by app/site.ts, which is the ONLY place the domain is resolved.
# Drives metadataBase, the canonical URL, OpenGraph/Twitter metadata,
# /robots.txt, /sitemap.xml and the web app manifest.
#
# Leave unset in production: it defaults to https://supacharge.school.
# Set it on Vercel preview deployments so previews advertise their own URL
# (e.g. https://$VERCEL_URL) instead of claiming to be the production site.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Rokct platform gateway.
# ---------------------------------------------------------------------------
# Base origin of the Frappe backend. Read by the base_sdk platform client
# (core/base/nextjs/src/services/platform-gateway.ts), which appends the single
# gateway path /api/v1/method/rokct.platform.api and names the target method in
# the request's `cmd` field. Server-side value first, public fallback second.
#
# The holding page in app/page.tsx makes no API calls, so neither is required
# to build or serve today. They are documented here because any SDK composed
# into this shell will read them.
ROKCT_BASE_URL=
NEXT_PUBLIC_ROKCT_BASE_URL=

# ---------------------------------------------------------------------------
# auth_sdk (composed; RokctAI/Users auth/nextjs).
# ---------------------------------------------------------------------------
# THIS SHELL NEEDS NO DATABASE. auth_sdk >= 1.6.0 puts the three tenant-mapping
# operations its credentials flow performs behind a registry seam
# (app/(auth)/tenant-link.ts), and next.config.mjs selects the single-tenant
# implementation with `env: { ROKCT_TENANT_LINK: "single-tenant" }`. That
# implementation imports neither @/db nor drizzle nor postgres: login and
# register open no Postgres connection, so POSTGRES_URL is not a variable this
# project sets - in Vercel or anywhere else.
#
# The switch lives in committed code rather than here because it is a property
# of the shell, not of a deployment. Setting ROKCT_TENANT_LINK in the
# environment will NOT override it: next.config.mjs `env` is inlined at build
# time and wins. Changing it is a code change, deliberately.
#
# What the local store was FOR, for the record: it maps a user to the tenant
# base URL they came from, which is a multi-tenancy feature. rokctai_frontend
# serves many tenant backends, reads that mapping on every login and migrates
# the schema before `next build`. supacharge-web serves one tenant and reads
# its backend from ROKCT_BASE_URL above.
#
# POSTGRES_URL / POSTGRES_URL_NON_POOLING: deliberately absent.

# ---------------------------------------------------------------------------
# Platform administrator for /register (optional).
# ---------------------------------------------------------------------------
# Provisioning a new subscription is a GUEST call - there is no session yet -
# so it goes out as the platform administrator. The drizzle default reads those
# keys from the GlobalSettings table, which is itself only a cache of "an
# administrator signed in here once"; the single-tenant link reads them from
# the deployment instead. They are NOT fetched from the gateway: an
# unauthenticated cmd that handed out administrator credentials would be a
# credential oracle open to the internet.
#
# Leave unset and /register still renders, but submitting it stops with
# "System not initialized. Administrator must login first." - the same message
# an empty GlobalSettings row produces on rokctai_frontend. Set them to accept
# registrations. Secrets: set them in the Vercel project, never here.
ROKCT_ADMIN_API_KEY=
ROKCT_ADMIN_API_SECRET=

# NextAuth signing secret. Not read at build time; required at runtime by the
# composed /api/auth/[...nextauth] handler and by every session read.
AUTH_SECRET=
