# supacharge-web — environment variables this shell reads.
#
# Copy to .env.local for local development. Never commit real values: secrets
# live in the private RokctAI/occultation workspace and are set in the Vercel
# project's Environment Variables, not in this file.

# ---------------------------------------------------------------------------
# Public origin of this deployment.
# ---------------------------------------------------------------------------
# Read by app/site.ts, which is the ONLY place the domain is resolved.
# Drives metadataBase, the canonical URL, OpenGraph/Twitter metadata,
# /robots.txt, /sitemap.xml and the web app manifest.
#
# Leave unset in production: it defaults to https://supacharge.app.
# Set it on Vercel preview deployments so previews advertise their own URL
# (e.g. https://$VERCEL_URL) instead of claiming to be the production site.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Rokct platform gateway.
# ---------------------------------------------------------------------------
# Base origin of the Frappe backend. Read by the base_sdk platform client
# (core/base/nextjs/src/services/platform-gateway.ts), which appends the single
# gateway path /api/v1/method/rokct.platform.api and names the target method in
# the request's `cmd` field. Server-side value first, public fallback second.
#
# The holding page in app/page.tsx makes no API calls, so neither is required
# to build or serve today. They are documented here because any SDK composed
# into this shell will read them.
ROKCT_BASE_URL=
NEXT_PUBLIC_ROKCT_BASE_URL=

# ---------------------------------------------------------------------------
# auth_sdk (composed; RokctAI/Users auth/nextjs).
# ---------------------------------------------------------------------------
# The composed auth surface reaches Postgres through drizzle (db/index.ts,
# installed by auth_sdk). The local store is a MULTI-TENANCY feature: it
# remembers which tenant site a user belongs to, so a deployment serving many
# tenant backends needs it. supacharge-web is dedicated to a single tenant.
#
# NOT read at build time. auth_sdk 1.4.1 creates the postgres client lazily on
# first use, so `next build` no longer needs this set — which is why Vercel,
# where POSTGRES_URL is a runtime-only value, can build the composed tree at
# all. (Before 1.4.1 db/index.ts threw at module load and the build died
# collecting page data for /api/auth/[...nextauth]; do not reintroduce a
# placeholder value to work around that.)
#
# At RUNTIME the composed auth paths still read and write it, and the guard
# still throws the same error on the first query if it is unset: the login
# handler looks the user's site up before authenticating, and /register
# writes the user row and reads admin keys from GlobalSettings. A real
# database is also needed for `npm run db:migrate`, which this shell's build
# script does not run — unlike rokctai_frontend's, which migrates before
# `next build`.
#
# The bare holding-page build reads neither.
POSTGRES_URL=
# Optional: direct (non-pooled) URL for `npm run db:migrate`; falls back to
# POSTGRES_URL.
POSTGRES_URL_NON_POOLING=

# NextAuth signing secret. Not read at build time; required at runtime by the
# composed /api/auth/[...nextauth] handler and by every session read.
AUTH_SECRET=
